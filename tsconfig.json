{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "./src",
    "paths": {
      "_helpers/*": ["helpers/*"],
      "_middleware/*": ["_middleware/*"],
      "users/*": ["users/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}